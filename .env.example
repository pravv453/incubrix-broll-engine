# Copy to .env and adjust. Every setting the service reads is listed here
# (tests/unit/test_core.py fails if one is missing). Never commit real keys.
# Defaults below run fully offline with mock providers (no API keys needed).

# ---------------------------------------------------------------- app
APP_ENV=development
APP_VERSION=0.1.0
GIT_SHA=unknown
LOG_LEVEL=INFO
# When set, every /api/v1 route needs "Authorization: Bearer <token>" (use for the public demo)
DEMO_ACCESS_TOKEN=
# POST requests per client IP per minute (0 disables)
RATE_LIMIT_PER_MINUTE=30
PUBLIC_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------- infrastructure
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/broll
REDIS_URL=redis://redis:6379/0
# celery (compose) | inline (tests: run jobs in a thread inside the API process)
JOB_RUNNER=celery
# s3 (S3-compatible store in compose, or AWS S3/R2/...) | local (tests)
STORAGE_BACKEND=s3
LOCAL_STORAGE_DIR=/tmp/broll-storage
S3_ENDPOINT=http://objectstore:9000
# Host used inside presigned download links (what your browser/batch runner can reach)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=broll
S3_SECRET_KEY=change-me-s3-secret
S3_BUCKET=broll
S3_REGION=us-east-1
S3_PRESIGN_EXPIRY_S=86400
WORK_DIR=/tmp/broll-work
MODEL_CACHE_DIR=/tmp/broll-models

# ---------------------------------------------------------------- providers
# ASR: mock | faster_whisper        (faster_whisper model: tiny|base|small|medium|large-v3)
ASR_PROVIDER=mock
ASR_MODEL=small
ASR_COMPUTE_TYPE=int8
# TTS: mock | gemini
TTS_PROVIDER=mock
# Scene planner: rules | gemini
LLM_PROVIDER=rules
# Text embeddings: mock | fastembed
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Visual scorer for thumbnails: disabled | mock | clip
VISION_PROVIDER=disabled
VISION_TEXT_MODEL=Qdrant/clip-ViT-B-32-text
VISION_IMAGE_MODEL=Qdrant/clip-ViT-B-32-vision
# Face detector (enforces avoid=faces, keeps generated media face-free): disabled | mock | yunet
FACE_DETECTOR=disabled
FACE_MODEL_PATH=/opt/models/face_detection_yunet_2023mar.onnx
# Independent relevance judge (Outstanding): disabled | mock | gemini
JUDGE_PROVIDER=disabled
# Stock footage sources, comma-separated in priority order: mock | pixabay
FOOTAGE_PROVIDERS=mock
# Second source - AI image -> motion clip: disabled | mock | gemini
GENERATED_PROVIDER=mock
GEMINI_API_KEY=
# Set model IDs from the live Gemini model catalogue (https://ai.google.dev/gemini-api/docs/models)
GEMINI_TEXT_MODEL=
GEMINI_TTS_MODEL=
# e.g. gemini-3.8-flash-tts (Interactions API)
GEMINI_IMAGE_MODEL=
GEMINI_JUDGE_MODEL=
# request voice -> Gemini prebuilt voice name
GEMINI_TTS_VOICE_MAP=en-IN-female=Kore,en-IN-male=Puck,hi-IN-female=Kore,ta-IN-female=Kore
PIXABAY_API_KEY=
FOOTAGE_MAX_CANDIDATES=12
FOOTAGE_REQUEST_TIMEOUT_S=20
FOOTAGE_CACHE_TTL_S=86400
# Runtime fault injection: JSON file like {"pixabay": "down"} (modes: down|empty|corrupt|slow)
FAULT_INJECTION_FILE=

# ---------------------------------------------------------------- ranking & selection
# Rights eligibility is a hard gate, not a weight. Weights are renormalised over available components.
RANK_W_SEMANTIC=0.45
RANK_W_VISUAL=0.20
RANK_W_DURATION=0.10
RANK_W_ASPECT=0.10
RANK_W_QUALITY=0.10
RANK_W_RIGHTS=0.05
# tau: if the best eligible stock clip scores below this, an AI-generated clip is used instead
STOCK_MIN_SCORE=0.55
CANDIDATES_TO_PROBE=4

# ---------------------------------------------------------------- output / media
OUTPUT_FPS=30
OUTPUT_WIDTH_LANDSCAPE=1920
OUTPUT_HEIGHT_LANDSCAPE=1080
OUTPUT_WIDTH_PORTRAIT=1080
OUTPUT_HEIGHT_PORTRAIT=1920
OUTPUT_WIDTH_SQUARE=1080
OUTPUT_HEIGHT_SQUARE=1080
VIDEO_CRF=21
VIDEO_PRESET=veryfast
AUDIO_BITRATE=192k
COLOUR_NORMALISE=true
TARGET_LUMA=0.45
CAPTION_FONT=Noto Sans
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
FFMPEG_THREADS=0

# ---------------------------------------------------------------- scenes & captions
MIN_SCENE_S=1.5
MAX_SCENE_S=8.0
TARGET_SCENE_S=3.0
CAPTION_MAX_CHARS=42
CAPTION_MAX_WORDS=8

# ---------------------------------------------------------------- limits
MAX_AUDIO_DURATION_S=600
MAX_UPLOAD_MB=200
MAX_SCRIPT_CHARS=10000
MAX_CONCURRENT_JOBS=2
URL_FETCH_TIMEOUT_S=30
MIN_SPEECH_RATIO=0.15

# ---------------------------------------------------------------- callbacks
CALLBACK_HMAC_SECRET=
CALLBACK_ALLOWED_HOSTS=
CALLBACK_TIMEOUT_S=10

# ---------------------------------------------------------------- cost model (USD; blank = unknown, never guessed)
COST_TTS_PER_1K_CHARS=
COST_LLM_PER_CALL=
COST_IMAGE_PER_GENERATION=
COST_JUDGE_PER_CALL=
COST_COMPUTE_PER_HOUR=

SEED=1234
